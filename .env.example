# Frontend (Vite)
# static = fixtures only (form fakes success); supabase = pre-registrations persist (#149)
VITE_DATA_PROVIDER=static          # static | supabase | api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Database / Supabase (#13). Two free projects in sa-east-1: sieamb-prod (Vercel
# Production) and sieamb-dev (Vercel Preview + Development, local, CI).
# Local: copy this file to .env and fill it from Supabase → Project Settings.
# Cloud: same names live in Vercel env vars (per environment) and GitHub secrets
# (prefixed SUPABASE_PROD_* / SUPABASE_DEV_*). Never commit filled values.
DATABASE_URL=   # transaction pooler, port 6543, ?pgbouncer=true — runtime (Prisma via pg adapter)
DIRECT_URL=     # session pooler, port 5432 — migrations, seed, pg_dump (db.<ref> host is IPv6-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, bypasses RLS
JWT_SECRET=

# Accounts (#208). Off unless both are "true"; production stays off until released.
VITE_ACCOUNTS_ENABLED=       # frontend: shows Entrar, Minha área and the account pages
ACCOUNTS_ENABLED=            # server: /api/v1/account/* answers 503 without it

# Payments (Phase 3)
MP_ACCESS_TOKEN=            # server only; sandbox value outside production
MP_WEBHOOK_SECRET=          # secret of the Mercado Pago webhook for the same environment

# Payment e-mails (#185). Without SMTP_USER and SMTP_PASS the e-mails are recorded and wait.
SMTP_USER=                  # server only; the event Gmail address (or "resend")
SMTP_PASS=                  # server only; a Gmail app password, never the account password
SMTP_HOST=                  # optional, default smtp.gmail.com
SMTP_PORT=                  # optional, default 465
MAIL_FROM=                  # optional, e.g. II SIEAmB <address>
MAIL_REPLY_TO=              # optional; where answers to the e-mails go, e.g. the committee inbox
SITE_URL=                   # optional, origin of the links in the e-mails
CRON_SECRET=                # server only; what the scheduled sweep presents to /api/v1/payments/emails/deliver
REMINDERS_ENABLED=          # "true" turns on reminders to unpaid registrations (#187); off by default
# PAYMENTS_NOW=2026-11-12T12:00:00-03:00   # non-production only: moves the clock of the fee lookup to try a lot before it starts

# Email (Phase 1+)
RESEND_API_KEY=
