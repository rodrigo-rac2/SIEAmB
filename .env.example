# Frontend (Vite)
# static = fixtures only (form fakes success); supabase = pre-registrations persist (#149)
VITE_DATA_PROVIDER=static          # static | supabase | api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=

# Database / Supabase (#13). Two free projects in sa-east-1: sieamb-prod (Vercel
# Production) and sieamb-dev (Vercel Preview + Development, local, CI).
# Local: copy this file to .env and fill it from Supabase → Project Settings.
# Cloud: same names live in Vercel env vars (per environment) and GitHub secrets
# (prefixed SUPABASE_PROD_* / SUPABASE_DEV_*). Never commit filled values.
DATABASE_URL=   # transaction pooler, port 6543, ?pgbouncer=true — runtime (Prisma via pg adapter)
DIRECT_URL=     # session pooler, port 5432 — migrations, seed, pg_dump (db.<ref> host is IPv6-only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, bypasses RLS
JWT_SECRET=

# Payments (Phase 3)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Email (Phase 1+)
RESEND_API_KEY=
