// SIEAmB database schema — Phase 1 subset of docs/IMPLEMENTATION_PLAN.md §3.
// Conventions: UUID PKs, snake_case table/column names, money in integer centavos,
// created_at/updated_at everywhere. Localized text (pt-BR/en/es/zh-CN) is stored as
// JSON in the same shape as `LocalizedText` in @sieamb/shared.
// Later issues add payments (#16), submissions and review (#17, #21), certificates (#22).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Events (multi-event core) ─────────────────────────────

model Event {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique // "2027"
  legacySlugs  String[] @default([]) @map("legacy_slugs") // old slugs that redirect here
  name         String // "II SIEAmB"
  fullName     String   @map("full_name")
  edition      Int
  aboutMd      Json?    @map("about_md") // LocalizedText, markdown
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  venue        Json? // LocalizedText
  isOnline     Boolean  @default(false) @map("is_online")
  venueUrl     String?  @map("venue_url")
  isCurrent    Boolean  @default(false) @map("is_current") // exactly one true (partial unique index in migration SQL)
  isArchived   Boolean  @default(false) @map("is_archived")
  heroImageUrl String?  @map("hero_image_url")
  logoUrl      String?  @map("logo_url")
  lockupUrl    String?  @map("lockup_url")
  theme        Json? // EventTheme (ADR-001)
  settings     Json     @default("{}") // registrationOpen, submissionsOpen, showProgram…
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  importantDates   ImportantDate[]
  thematicAreas    ThematicArea[]
  committeeMembers CommitteeMember[]
  sponsors         Sponsor[]
  pages            StaticPage[]
  members          EventMember[]
  news             News[]
  feeTiers         FeeTier[]
  registrations    Registration[]
  preRegistrations PreRegistration[]
  payments         Payment[]
  submissions      Submission[]
  memberInvites    EventMemberInvite[]
  announcements    Announcement[]

  @@map("events")
}

model ImportantDate {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  label      Json // LocalizedText
  date       DateTime
  isExtended Boolean  @default(false) @map("is_extended") // strikethrough old date pattern
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  event      Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("important_dates")
}

model ThematicArea {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  code        String // "AT-01"
  name        Json // LocalizedText
  description Json? // LocalizedText
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  event       Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, code])
  @@map("thematic_areas")
}

model CommitteeMember {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  role        String // "Comitê Científico", "Revisores", "Mídias"…
  institution String?
  bioMd       Json?    @map("bio_md") // LocalizedText
  photoUrl    String?  @map("photo_url")
  lattesUrl   String?  @map("lattes_url")
  orcid       String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("committee_members")
}

model Sponsor {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  tier      String   @default("apoio") // "realização" | "patrocínio" | "apoio"
  logoUrl   String   @map("logo_url")
  website   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  event     Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("sponsors")
}

// Committee-editable pages (editais, regras de submissão…) so text changes
// don't need a deploy once the admin panel exists.
model StaticPage {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  slug      String // "edital-2027"
  title     Json // LocalizedText
  bodyMd    Json     @map("body_md") // LocalizedText, markdown
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, slug])
  @@map("static_pages")
}

// ───────────────────────────── Users & roles (ADR-002) ─────────────────────────────

model User {
  id              String   @id @db.Uuid // == Supabase auth.users.id (trigger in migration SQL)
  email           String   @unique
  fullName        String   @default("") @map("full_name")
  cpf             String?  @unique // digits only; null for foreigners
  passport        String?
  country         String   @default("BR")
  institution     String?
  lattesUrl       String?  @map("lattes_url")
  orcid           String?
  phone           String?
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships      EventMember[]
  registrations    Registration[]
  newsAuthored     News[]
  preRegistrations PreRegistration[]
  linkRequests     RegistrationLinkRequest[]
  submissions      Submission[]
  notifications    Notification[]

  @@map("users")
}

// Roles are per edition. Participant/author/registered are derived states, never roles.
enum EventRole {
  ADMIN
  SCIENTIFIC_CHAIR
  AREA_CHAIR
  REVIEWER
  EDITOR
  FINANCE
  STAFF
  ORGANIZER // "Organizador" of the submission system (#217): follows registrations and papers, cannot change them by hand
}

model EventMember {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  role      EventRole
  areaIds   String[]  @default([]) @map("area_ids") @db.Uuid // only meaningful for AREA_CHAIR
  invitedBy String?   @map("invited_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId, role])
  @@index([eventId, role])
  @@map("event_members")
}

// ───────────────────────────── News ─────────────────────────────

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model News {
  id            String     @id @default(uuid()) @db.Uuid
  eventId       String     @map("event_id") @db.Uuid
  authorId      String?    @map("author_id") @db.Uuid
  slug          String
  title         Json // LocalizedText
  excerpt       Json? // LocalizedText
  bodyMd        Json       @map("body_md") // LocalizedText, markdown
  coverImageUrl String?    @map("cover_image_url")
  status        NewsStatus @default(DRAFT)
  isPinned      Boolean    @default(false) @map("is_pinned")
  publishedAt   DateTime?  @map("published_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at") // soft delete

  event  Event @relation(fields: [eventId], references: [id])
  author User? @relation(fields: [authorId], references: [id])

  @@unique([eventId, slug])
  @@index([eventId, status, publishedAt])
  @@map("news")
}

// ───────────────────────────── Registration & fees ─────────────────────────────

enum ParticipantCategory {
  ESTUDANTE_GRADUACAO
  ESTUDANTE_POS
  PROFESSOR
  PROFISSIONAL
  COMUNIDADE // adjust with the committee (#7)
}

enum Modality {
  PRESENCIAL
  ONLINE
}

// Fee matrix: category × lot window × modality
model FeeTier {
  id          String              @id @default(uuid()) @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  category    ParticipantCategory
  modality    Modality
  label       Json // LocalizedText, "Lote 1 (até 01/01)"
  amountCents Int                 @map("amount_cents")
  validFrom   DateTime            @map("valid_from")
  validUntil  DateTime            @map("valid_until")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  event       Event               @relation(fields: [eventId], references: [id])

  registrations Registration[]

  @@index([eventId, category, modality])
  @@map("fee_tiers")
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED // paid or exempt
  CANCELLED
  AWAITING_EMPENHO // public-institution purchase-order flow
}

model Registration {
  id          String              @id @default(uuid()) @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  feeTierId   String?             @map("fee_tier_id") @db.Uuid
  category    ParticipantCategory
  modality    Modality
  status      RegistrationStatus  @default(PENDING_PAYMENT)
  proofUrl    String?             @map("proof_url") // student proof upload
  checkedInAt DateTime?           @map("checked_in_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  feeTier FeeTier? @relation(fields: [feeTierId], references: [id])

  @@unique([eventId, userId]) // one registration per user per event
  @@index([eventId, status])
  @@map("registrations")
}

// Pre-registration (#149): the public form before accounts exist. Anonymous
// insert-only through RLS; nobody but service_role reads it. Rows migrate into
// registrations once accounts and payment exist (#14).
model PreRegistration {
  // DB-side default: the browser inserts through PostgREST, so Prisma's client-side uuid() never runs.
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  fullName    String              @map("full_name")
  email       String // lower-cased by the frontend; unique per event
  cpf         String? // digits only; null for foreigners
  passport    String?
  country     String              @default("BR")
  institution String?
  category    ParticipantCategory
  modality    Modality
  locale      String              @default("pt-BR") // UI language at submission, for the e-mail later
  consentAt   DateTime            @map("consent_at") // LGPD consent given on the form
  // Unguessable handle for starting a payment (#160). The browser generates it on
  // insert because it cannot read the row back; older rows get one from the database.
  payToken    String              @unique @default(dbgenerated("gen_random_uuid()")) @map("pay_token") @db.Uuid
  // The account this registration belongs to (#208). Set by the server only, once the
  // account's e-mail is confirmed and matches, or after a confirmed link request (#209).
  userId      String?             @map("user_id") @db.Uuid
  // Decided by an administrator, whatever the payment says (#219): who, when and why are kept.
  manualStatus  RegistrationOverride? @map("manual_status")
  manualReason  String?               @map("manual_reason")
  manualBy      String?               @map("manual_by") @db.Uuid
  manualAt      DateTime?             @map("manual_at")
  // Registered by an administrator on the person's behalf (#219).
  createdBy     String?               @map("created_by") @db.Uuid
  // Never erased (ADR-006, #204): a deleted registration is hidden everywhere and can be restored.
  deletedAt     DateTime?             @map("deleted_at")
  deletedBy     String?               @map("deleted_by") @db.Uuid
  deletedReason String?               @map("deleted_reason")
  createdAt   DateTime            @default(now()) @map("created_at")

  event        Event                     @relation(fields: [eventId], references: [id])
  user         User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments     Payment[]
  emails       PaymentEmail[]
  linkRequests RegistrationLinkRequest[]

  // One registration per e-mail and one per account in each event, counted over the
  // registrations that are not deleted: partial unique indexes in the migration SQL (#204).
  @@index([eventId, email])
  @@index([eventId, userId])
  @@index([cpf])
  @@index([passport])
  @@index([eventId, createdAt])
  @@map("pre_registrations")
}

// ───────────────────────────── Payments ─────────────────────────────

enum PaymentStatus {
  CREATED // order created, nothing paid yet
  PENDING // Mercado Pago is processing or waiting (boleto, manual review)
  APPROVED
  REJECTED
  CANCELLED // cancelled or expired before being paid
  REFUNDED
}

// One row per Mercado Pago order (#160). Written only by the server functions
// through service_role; the browser never reads or writes this table.
model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String        @map("event_id") @db.Uuid
  preRegistrationId String        @map("pre_registration_id") @db.Uuid
  status            PaymentStatus @default(CREATED)
  amountCents       Int           @map("amount_cents")
  feeTierRef        String        @map("fee_tier_ref") // id of the fee tier the price came from
  mpOrderId         String?       @unique @map("mp_order_id")
  mpStatus          String?       @map("mp_status")
  mpStatusDetail    String?       @map("mp_status_detail")
  checkoutUrl       String?       @map("checkout_url")
  orderSnapshot     Json?         @map("order_snapshot") // trimmed copy of the last order read from Mercado Pago, no payer data
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  event           Event           @relation(fields: [eventId], references: [id])
  preRegistration PreRegistration @relation(fields: [preRegistrationId], references: [id])
  emails          PaymentEmail[]

  @@index([preRegistrationId, status])
  @@map("payments")
}

enum PaymentEmailKind {
  PROCESSING // registration received, payment being processed
  CONFIRMED // payment confirmed, registration complete
  FAILED // payment refused, or cancelled after an attempt
  REMINDER // the registration is still unpaid (#187)
  RECEIVED // the form was submitted (#195)
}

enum PaymentEmailStatus {
  PENDING
  SENT
  SKIPPED // nothing to send: no valid address, or the payment moved on before delivery
}

// Outbox of the e-mails owed about a payment (#185). A row is written when the
// status changes and delivered right after, or by the scheduled sweep if that fails.
// `dedupeKey` makes the same e-mail impossible to owe twice: "<payment>:<kind>" for a
// status e-mail, "reminder:<registration>:<n>" for the n-th reminder (#187).
model PaymentEmail {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  preRegistrationId String             @map("pre_registration_id") @db.Uuid
  paymentId         String?            @map("payment_id") @db.Uuid // null for a reminder to someone who never started a payment
  kind              PaymentEmailKind
  dedupeKey         String             @unique @map("dedupe_key")
  status            PaymentEmailStatus @default(PENDING)
  attempts          Int                @default(0)
  lockedUntil       DateTime?          @map("locked_until") // a delivery attempt holds the row until then
  lastError         String?            @map("last_error") // error name only, never personal data
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  preRegistration PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([preRegistrationId])
  @@map("payment_emails")
}

// ───────────────────────────── Accounts (#208, #209) ─────────────────────────────

enum RegistrationOverride {
  CONFIRMED // counts as paid: paid outside the site, by empenho, in cash
  EXEMPT // no fee is owed
  CANCELLED
}

// A role given to an address that has no account yet (#219). It becomes a row in
// event_members the first time that address logs in with a confirmed e-mail.
model EventMemberInvite {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  email     String // lower-cased
  role      EventRole
  invitedBy String?   @map("invited_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, email, role])
  @@index([email])
  @@map("event_member_invites")
}

enum LinkRequestStatus {
  PENDING // waiting for the click on the link sent to the registration's e-mail
  CONFIRMED
  NEEDS_ORGANISER // the person has no access to that inbox; an organiser decides
  REJECTED
  EXPIRED
}

// "This registration under another e-mail is mine" (#209). A CPF or passport match
// only raises the question; the link e-mailed to the registration's address proves it.
model RegistrationLinkRequest {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  preRegistrationId String            @map("pre_registration_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  tokenHash         String            @unique @map("token_hash") // sha-256 of the token in the e-mail; the token itself is never stored
  status            LinkRequestStatus @default(PENDING)
  expiresAt         DateTime          @map("expires_at")
  decidedAt         DateTime?         @map("decided_at")
  decidedBy         String?           @map("decided_by") @db.Uuid // the organiser, when one decided
  createdAt         DateTime          @default(now()) @map("created_at")

  preRegistration PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([preRegistrationId, status])
  @@map("registration_link_requests")
}

// Counters behind the rate limits (#208). `key` is a hash, never an address or an IP.
// Written only through the hit_rate_limit() function.
model RateLimitHit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([key, windowStart])
  @@map("rate_limit_hits")
}

// ───────────────────────────── Submissions (#216) ─────────────────────────────

enum SubmissionModality {
  ARTIGO
  RESUMO_EXPANDIDO
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  APPROVED_WITH_REVISION
  REJECTED
}

// A paper sent to an edition. The main author is the account that sent it; every
// author, the main one included, is a row in submission_authors. Never erased:
// withdrawing or deleting sets deleted_at (ADR-006).
model Submission {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number        Int                @unique @default(autoincrement()) // what people quote: "trabalho nº 12"
  eventId       String             @map("event_id") @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  title         String
  titleEn       String             @map("title_en")
  modality      SubmissionModality
  areaRef       String             @map("area_ref") // id of the thematic area in the event's fixture, e.g. "a3"
  abstract      String
  keywords      String[]           @default([])
  keywordsEn    String[]           @default([]) @map("keywords_en")
  filePath      String             @map("file_path") // object in the private "submissions" bucket
  fileName      String             @map("file_name") // the name the author gave it
  filePages     Int?               @map("file_pages") // null when the file does not say (some Word files)
  status        SubmissionStatus   @default(SUBMITTED)
  locale        String             @default("pt-BR") // UI language of the sender, for the e-mails
  deletedAt     DateTime?          @map("deleted_at")
  deletedBy     String?            @map("deleted_by") @db.Uuid
  deletedReason String?            @map("deleted_reason")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @default(now()) @map("updated_at")

  event   Event              @relation(fields: [eventId], references: [id])
  user    User               @relation(fields: [userId], references: [id])
  authors SubmissionAuthor[]

  @@index([eventId, deletedAt])
  @@index([userId])
  @@map("submissions")
}

// Authors in the order of the paper; position 1 is the main author. A co-author is
// recognised by e-mail, so the paper shows up for them whenever they have an account.
model SubmissionAuthor {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  position     Int
  fullName     String   @map("full_name")
  email        String // lower-cased
  createdAt    DateTime @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, position])
  @@unique([submissionId, email])
  @@index([email])
  @@map("submission_authors")
}

// ───────────────────────────── Outbox and notifications (#217) ─────────────────────────────

enum OutboxStatus {
  PENDING
  SENT
  SKIPPED
}

// Any e-mail the system owes that is not about a payment (those have payment_emails).
// Same guarantees: `dedupeKey` makes it impossible to owe the same one twice, and the
// scheduled sweep retries what the request could not send. The body is cleared once sent.
model OutboxEmail {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail     String       @map("to_email")
  subject     String
  bodyText    String?      @map("body_text")
  bodyHtml    String?      @map("body_html")
  dedupeKey   String       @unique @map("dedupe_key")
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lockedUntil DateTime?    @map("locked_until")
  lastError   String?      @map("last_error")
  sentAt      DateTime?    @map("sent_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("outbox_emails")
}

// What an account sees under the bell. `kind` picks the text in the site's language
// and `data` fills it; nothing is stored already translated.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventId   String?   @map("event_id") @db.Uuid
  kind      String
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// A message an organiser sent to a group (#221). Kept as the record of who sent
// what, to whom and when; the copies people read are notifications and e-mails.
model Announcement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  audience   String // all | registered | authors | reviewers | organisers
  subject    String
  body       String
  recipients String[] @default([]) // the addresses it went to
  createdAt  DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId, createdAt])
  @@map("announcements")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String // "news.publish", "registration.confirm"
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}
