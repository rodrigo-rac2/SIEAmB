// SIEAmB database schema — Phase 1 subset of docs/IMPLEMENTATION_PLAN.md §3.
// Conventions: UUID PKs, snake_case table/column names, money in integer centavos,
// created_at/updated_at everywhere. Localized text (pt-BR/en/es/zh-CN) is stored as
// JSON in the same shape as `LocalizedText` in @sieamb/shared.
// Later issues add payments (#16), submissions and review (#17, #21), certificates (#22).

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Events (multi-event core) ─────────────────────────────

model Event {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique // "2027"
  legacySlugs  String[] @default([]) @map("legacy_slugs") // old slugs that redirect here
  name         String // "II SIEAmB"
  fullName     String   @map("full_name")
  edition      Int
  aboutMd      Json?    @map("about_md") // LocalizedText, markdown
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  venue        Json? // LocalizedText
  isOnline     Boolean  @default(false) @map("is_online")
  venueUrl     String?  @map("venue_url")
  isCurrent    Boolean  @default(false) @map("is_current") // exactly one true (partial unique index in migration SQL)
  isArchived   Boolean  @default(false) @map("is_archived")
  heroImageUrl String?  @map("hero_image_url")
  logoUrl      String?  @map("logo_url")
  lockupUrl    String?  @map("lockup_url")
  theme        Json? // EventTheme (ADR-001)
  settings     Json     @default("{}") // registrationOpen, submissionsOpen, showProgram…
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  importantDates   ImportantDate[]
  thematicAreas    ThematicArea[]
  committeeMembers CommitteeMember[]
  sponsors         Sponsor[]
  pages            StaticPage[]
  members          EventMember[]
  news             News[]
  feeTiers         FeeTier[]
  registrations    Registration[]
  preRegistrations PreRegistration[]

  @@map("events")
}

model ImportantDate {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  label      Json // LocalizedText
  date       DateTime
  isExtended Boolean  @default(false) @map("is_extended") // strikethrough old date pattern
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  event      Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("important_dates")
}

model ThematicArea {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  code        String // "AT-01"
  name        Json // LocalizedText
  description Json? // LocalizedText
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  event       Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, code])
  @@map("thematic_areas")
}

model CommitteeMember {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  role        String // "Comitê Científico", "Revisores", "Mídias"…
  institution String?
  bioMd       Json?    @map("bio_md") // LocalizedText
  photoUrl    String?  @map("photo_url")
  lattesUrl   String?  @map("lattes_url")
  orcid       String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  event       Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("committee_members")
}

model Sponsor {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  name      String
  tier      String   @default("apoio") // "realização" | "patrocínio" | "apoio"
  logoUrl   String   @map("logo_url")
  website   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  event     Event    @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("sponsors")
}

// Committee-editable pages (editais, regras de submissão…) so text changes
// don't need a deploy once the admin panel exists.
model StaticPage {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  slug      String // "edital-2027"
  title     Json // LocalizedText
  bodyMd    Json     @map("body_md") // LocalizedText, markdown
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  event     Event    @relation(fields: [eventId], references: [id])

  @@unique([eventId, slug])
  @@map("static_pages")
}

// ───────────────────────────── Users & roles (ADR-002) ─────────────────────────────

model User {
  id              String   @id @db.Uuid // == Supabase auth.users.id (trigger in migration SQL)
  email           String   @unique
  fullName        String   @default("") @map("full_name")
  cpf             String?  @unique // digits only; null for foreigners
  passport        String?
  country         String   @default("BR")
  institution     String?
  lattesUrl       String?  @map("lattes_url")
  orcid           String?
  phone           String?
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships   EventMember[]
  registrations Registration[]
  newsAuthored  News[]

  @@map("users")
}

// Roles are per edition. Participant/author/registered are derived states, never roles.
enum EventRole {
  ADMIN
  SCIENTIFIC_CHAIR
  AREA_CHAIR
  REVIEWER
  EDITOR
  FINANCE
  STAFF
}

model EventMember {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  role      EventRole
  areaIds   String[]  @default([]) @map("area_ids") @db.Uuid // only meaningful for AREA_CHAIR
  invitedBy String?   @map("invited_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId, role])
  @@index([eventId, role])
  @@map("event_members")
}

// ───────────────────────────── News ─────────────────────────────

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model News {
  id            String     @id @default(uuid()) @db.Uuid
  eventId       String     @map("event_id") @db.Uuid
  authorId      String?    @map("author_id") @db.Uuid
  slug          String
  title         Json // LocalizedText
  excerpt       Json? // LocalizedText
  bodyMd        Json       @map("body_md") // LocalizedText, markdown
  coverImageUrl String?    @map("cover_image_url")
  status        NewsStatus @default(DRAFT)
  isPinned      Boolean    @default(false) @map("is_pinned")
  publishedAt   DateTime?  @map("published_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  deletedAt     DateTime?  @map("deleted_at") // soft delete

  event  Event @relation(fields: [eventId], references: [id])
  author User? @relation(fields: [authorId], references: [id])

  @@unique([eventId, slug])
  @@index([eventId, status, publishedAt])
  @@map("news")
}

// ───────────────────────────── Registration & fees ─────────────────────────────

enum ParticipantCategory {
  ESTUDANTE_GRADUACAO
  ESTUDANTE_POS
  PROFESSOR
  PROFISSIONAL
  COMUNIDADE // adjust with the committee (#7)
}

enum Modality {
  PRESENCIAL
  ONLINE
}

// Fee matrix: category × lot window × modality
model FeeTier {
  id          String              @id @default(uuid()) @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  category    ParticipantCategory
  modality    Modality
  label       Json // LocalizedText, "Lote 1 (até 01/01)"
  amountCents Int                 @map("amount_cents")
  validFrom   DateTime            @map("valid_from")
  validUntil  DateTime            @map("valid_until")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  event       Event               @relation(fields: [eventId], references: [id])

  registrations Registration[]

  @@index([eventId, category, modality])
  @@map("fee_tiers")
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED // paid or exempt
  CANCELLED
  AWAITING_EMPENHO // public-institution purchase-order flow
}

model Registration {
  id          String              @id @default(uuid()) @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  feeTierId   String?             @map("fee_tier_id") @db.Uuid
  category    ParticipantCategory
  modality    Modality
  status      RegistrationStatus  @default(PENDING_PAYMENT)
  proofUrl    String?             @map("proof_url") // student proof upload
  checkedInAt DateTime?           @map("checked_in_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  event   Event    @relation(fields: [eventId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  feeTier FeeTier? @relation(fields: [feeTierId], references: [id])

  @@unique([eventId, userId]) // one registration per user per event
  @@index([eventId, status])
  @@map("registrations")
}

// Pre-registration (#149): the public form before accounts exist. Anonymous
// insert-only through RLS; nobody but service_role reads it. Rows migrate into
// registrations once accounts and payment exist (#14).
model PreRegistration {
  // DB-side default: the browser inserts through PostgREST, so Prisma's client-side uuid() never runs.
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  fullName    String              @map("full_name")
  email       String // lower-cased by the frontend; unique per event
  cpf         String? // digits only; null for foreigners
  passport    String?
  country     String              @default("BR")
  institution String?
  category    ParticipantCategory
  modality    Modality
  locale      String              @default("pt-BR") // UI language at submission, for the e-mail later
  consentAt   DateTime            @map("consent_at") // LGPD consent given on the form
  createdAt   DateTime            @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, email])
  @@index([eventId, createdAt])
  @@map("pre_registrations")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String // "news.publish", "registration.confirm"
  entity    String
  entityId  String?  @map("entity_id")
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}
